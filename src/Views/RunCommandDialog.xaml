<Window x:Class="emMDee.Views.RunCommandDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Run this command?"
        SizeToContent="Height"
        Width="520"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{DynamicResource ChromeBackground}"
        Foreground="{DynamicResource ChromeForeground}">
    <Grid Margin="20,18,20,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="This link runs a program."
                   FontSize="15"
                   FontWeight="SemiBold"
                   Foreground="{DynamicResource ChromeForeground}"/>

        <TextBlock Grid.Row="1"
                   Margin="0,8,0,0"
                   TextWrapping="Wrap"
                   Opacity="0.8"
                   Foreground="{DynamicResource ChromeForeground}"
                   Text="Opening it will execute the file below on this machine. Only run commands from a document you trust."/>

        <Border Grid.Row="2"
                Margin="0,12,0,0"
                Padding="10,8"
                CornerRadius="6"
                Background="{DynamicResource ContentBackground}"
                BorderBrush="{DynamicResource ChromeBorderBrush}"
                BorderThickness="1">
            <StackPanel>
                <TextBlock x:Name="PathText"
                           FontFamily="Consolas, Cascadia Mono, monospace"
                           FontSize="12"
                           TextWrapping="Wrap"
                           Foreground="{DynamicResource ChromeForeground}"/>
                <TextBlock x:Name="LaunchText"
                           Margin="0,6,0,0"
                           FontFamily="Consolas, Cascadia Mono, monospace"
                           FontSize="12"
                           TextWrapping="Wrap"
                           Opacity="0.85"
                           Foreground="{DynamicResource ChromeForeground}"
                           Visibility="Collapsed"/>
            </StackPanel>
        </Border>

        <CheckBox x:Name="RememberBox"
                  Grid.Row="3"
                  Margin="0,14,0,0"
                  Foreground="{DynamicResource ChromeForeground}"
                  IsChecked="False">
            <TextBlock x:Name="RememberText" TextWrapping="Wrap" MaxWidth="430"/>
        </CheckBox>

        <StackPanel Grid.Row="4"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,18,0,0">
            <Button x:Name="CancelButton"
                    Content="Cancel"
                    MinWidth="88"
                    Padding="12,6"
                    IsCancel="True"
                    Click="OnCancel"/>
            <Button x:Name="RunButton"
                    Content="Run"
                    MinWidth="88"
                    Padding="12,6"
                    Margin="10,0,0,0"
                    IsDefault="True"
                    Click="OnRun"/>
        </StackPanel>
    </Grid>
</Window>
